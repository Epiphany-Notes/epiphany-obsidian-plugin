{
  "name": "epiphany-plugin",
  "version": "2.0.0",
  "description": "Voice note capture and sync plugin for Obsidian. Dictate from iPhone and Apple Watch with photo and link attachments",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "voice-notes",
    "dictation",
    "transcription",
    "speech-to-text",
    "mobile-notes",
    "apple-watch"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "1.8.7",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  }
}
